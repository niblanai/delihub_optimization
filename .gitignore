# ═══════════════════════════════════════════════════════════════════════════════
# .gitignore for DeliHub (Qt6 + CMake + C++ Project)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Build directories ──────────────────────────────────────────────────────────
# These are generated by CMake and contain compiled binaries
build/
build_debug/
build_release/
dist/
cmake-build-*/
out/

# ── CMake generated files ──────────────────────────────────────────────────────
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CPackConfig.cmake
CPackSourceConfig.cmake
*.ninja
.ninja_deps
.ninja_log
install_manifest.txt

# ── Compiled binaries and libraries ────────────────────────────────────────────
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.exp
*.ilk
*.pdb
*.obj
*.o

# ── Qt generated files ─────────────────────────────────────────────────────────
*_autogen/
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.qm

# ── IDE and editor files ───────────────────────────────────────────────────────
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Visual Studio
.vs/
*.user
*.suo
*.sln.docstates
*.vcxproj.user

# Qt Creator
*.pro.user
*.pro.user.*
CMakeLists.txt.user*

# CLion / IntelliJ IDEA
.idea/
cmake-build-*/

# ── Temporary and backup files ─────────────────────────────────────────────────
*~
*.bak
*.swp
*.swo
*.tmp
*.temp
*.log
*.cache

# ── Runtime and user data ──────────────────────────────────────────────────────
# Don't commit user's actual config (may contain passwords/secrets)
config.ini
*.db
*.sqlite
*.sqlite3
backup_*.zip
crash_report.txt

# Keep template config for reference
!config.ini.template

# ── Python (for xls_reader.pyz and tools) ──────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
venv/
.Python

# ── Temporary extraction folders ───────────────────────────────────────────────
temp_*/
magazine_system_files/

# ── Test outputs ───────────────────────────────────────────────────────────────
test_output/
ocr_test_results.txt
psm_compare.txt
*.test.log

# ── System files ───────────────────────────────────────────────────────────────
# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
.directory
*.core

# ── Certificates and keys (NEVER commit these!) ────────────────────────────────
*.key
*.pem
*.p12
*.pfx
ca-certificates.crt

# ── Package manager artifacts ──────────────────────────────────────────────────
# If using vcpkg or conan
vcpkg_installed/
conan.lock
conanbuildinfo.*

# ── Documentation build outputs ────────────────────────────────────────────────
docs/_build/
docs/html/
docs/latex/

# ── IMPORTANT: Files TO KEEP (explicitly not ignored) ──────────────────────────
# These MUST be in the repository for others to build the project

# !src/                    # Source code (already not ignored)
# !CMakeLists.txt          # Build configuration (already not ignored)
# !*.sql                   # Database schemas (already not ignored)
# !src/sidebar/*.svg       # Icons (already not ignored)
# !build_release.ps1       # Build script (already not ignored)
# !README.md               # Documentation (already not ignored)
